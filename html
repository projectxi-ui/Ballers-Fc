
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#071426">
  <meta name="description" content="Official BALLERS FC website 2026/27">
  <title>BALLERS FC | Official Website</title>

  <link rel="stylesheet" href="style.css">
</head>
<body>

  <!-- TOP BAR -->
  <div class="topline">
    <span>SEASON 2026 / 27</span>
    <span>UNITED BY FOOTBALL</span>
  </div>

  <!-- NAVIGATION -->
  <header class="site-header">
    <a class="brand" href="#home">
      <img src="assets/ballers-crest.jpg" alt="BALLERS FC Crest">
      <span>
        <strong>BALLERS FC</strong>
        <small>OFFICIAL CLUB WEBSITE</small>
      </span>
    </a>

    <button class="menu-toggle">☰</button>

    <nav class="nav">
      <a href="#home">HOME</a>
      <a href="#club">THE CLUB</a>
      <a href="#squad">SQUAD</a>
      <a href="#fixtures">FIXTURES</a>
      <a href="#stats">STATS</a>
      <a href="#gallery">GALLERY</a>
      <a href="#shop">SHOP</a>
    </nav>

    <a class="header-cta" href="#contact">CONTACT ↗</a>
  </header>

  <main>

    <!-- HERO SECTION -->
    <section class="hero" id="home">
      <div class="hero-copy">
        <p class="eyebrow">THE OFFICIAL HOME OF BALLERS FC</p>

        <p class="season">2026 — 2027</p>

        <h1>
          ONE CLUB.<br>
          ONE GENERATION.<br>
          <em>ONE IDENTITY.</em>
        </h1>

        <p class="hero-sub">
          Built by friendship. Driven by football.<br>
          Connected by one badge.
        </p>

        <div class="hero-actions">
          <a class="button button-gold" href="#club">
            DISCOVER THE CLUB ↗
          </a>

          <a class="text-link" href="#gallery">
            VIEW THE NEW KIT →
          </a>
        </div>

        <div class="hero-foot">
          <span>EST. 2026</span>
          <span>UNITED BY FOOTBALL.</span>
        </div>
      </div>

      <div class="hero-art">
        <img
          src="assets/ballers-2026-home-kit.jpg"
          alt="BALLERS FC 2026/27 Home Kit">
        <div class="art-label">
          <small>HOME KIT</small>
          <strong>26 / 27</strong>
        </div>
      </div>
    </section>

    <!-- MOTTO TICKER -->
    <div class="ticker">
      UNITED BY FOOTBALL ✦
      ONE CLUB. ONE GENERATION. ONE IDENTITY. ✦
      BALLERS FC ✦
      UNITED BY FOOTBALL.
    </div>

    <!-- ABOUT THE CLUB -->
    <section class="section intro" id="club">
      <div class="section-kicker">01 / WHO WE ARE</div>

      <div class="intro-grid">
        <div>
          <p class="eyebrow">MORE THAN A TEAM</p>
          <h2>
            OUR GAME.<br>
            <em>OUR GENERATION.</em>
          </h2>
        </div>

        <div class="intro-text">
          <p class="large">
            BALLERS FC is a team brought together by a shared love of football.
          </p>

          <p>
            We represent teamwork, respect, ambition and the
            friendships built on and off the pitch.
            Every player brings something different.
            The badge brings us together.
          </p>

          <p class="gold-quote">
            "UNITED BY FOOTBALL."
          </p>
        </div>
      </div>

      <div class="values">
        <article>
          <span>01</span>
          <h3>UNITY</h3>
          <p>Different players. One team. One purpose.</p>
        </article>

        <article>
          <span>02</span>
          <h3>RESPECT</h3>
          <p>For teammates, opponents, officials and the game.</p>
        </article>

        <article>
          <span>03</span>
          <h3>AMBITION</h3>
          <p>Keep learning. Keep competing. Keep moving forward.</p>
        </article>
      </div>
    </section>

    <!-- SEASON -->
    <section class="season-band">
      <div>
        <p class="eyebrow">A NEW CHAPTER</p>
        <h2>THE 26/27<br><em>SEASON.</em></h2>
        <p>A fresh season. A shared identity. The journey continues.</p>
      </div>

      <img src="assets/ballers-crest.jpg" alt="BALLERS FC Crest">

      <div class="season-stamp">
        EST.<br><b>2026</b>
      </div>
    </section>

    <!-- SQUAD -->
    <section class="section" id="squad">
      <div class="section-heading">
        <div>
          <div class="section-kicker">02 / THE TEAM</div>
          <h2>MEET THE <em>SQUAD.</em></h2>
        </div>

        <span class="coming">PLAYER PROFILES COMING SOON</span>
      </div>

      <div class="empty-panel">
        <div class="empty-icon">XI</div>
        <h3>THE TEAM SHEET IS BEING PREPARED.</h3>
        <p>
          Player names, shirt numbers, positions and profiles
          will be published here once confirmed.
        </p>
      </div>
    </section>

    <!-- FIXTURES -->
    <section class="section dark-section" id="fixtures">
      <div class="section-heading">
        <div>
          <div class="section-kicker">03 / MATCH CENTRE</div>
          <h2>FIXTURES & <em>RESULTS.</em></h2>
        </div>
        <span class="coming">2026 / 27</span>
      </div>

      <div class="match-placeholder">
        <div>
          <small>NEXT MATCH</small>
          <h3>THE NEXT CHAPTER<br>STARTS ON THE PITCH.</h3>
          <p>Fixtures and results will appear here when confirmed.</p>
        </div>

        <div class="match-mark">BF <span>VS</span> ?</div>
      </div>
    </section>

    <!-- STATISTICS -->
    <section class="section" id="stats">
      <div class="section-heading">
        <div>
          <div class="section-kicker">04 / BY THE NUMBERS</div>
          <h2>CLUB <em>STATISTICS.</em></h2>
        </div>
      </div>

      <div class="stats-grid">
        <article>
          <strong>—</strong>
          <span>MATCHES PLAYED</span>
        </article>

        <article>
          <strong>—</strong>
          <span>WINS</span>
        </article>

        <article>
          <strong>—</strong>
          <span>GOALS SCORED</span>
        </article>

        <article>
          <strong>—</strong>
          <span>ASSISTS</span>
        </article>
      </div>

      <p class="muted-note">
        Official statistics will be updated as match records are confirmed.
      </p>
    </section>

    <!-- GALLERY -->
    <section class="section gallery-section" id="gallery">
      <div class="section-heading">
        <div>
          <div class="section-kicker">05 / CLUB CULTURE</div>
          <h2>THE BALLERS <em>LOOK.</em></h2>
        </div>

        <span class="coming">2026 / 27 HOME KIT</span>
      </div>

      <div class="gallery-grid">
        <figure class="kit-photo">
          <img
            src="assets/ballers-2026-home-kit.jpg"
            alt="BALLERS FC Home Kit">
          <figcaption>
            <span>01 / HOME KIT</span>
            <b>WHITE. NAVY. GOLD.</b>
          </figcaption>
        </figure>

        <figure class="crest-photo">
          <img
            src="assets/ballers-crest.jpg"
            alt="BALLERS FC Crest">
          <figcaption>
            <span>02 / THE BADGE</span>
            <b>OUR IDENTITY.</b>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- SHOP -->
    <section class="shop-banner" id="shop">
      <div>
        <p class="eyebrow">WEAR THE BADGE</p>
        <h2>THE CLUB SHOP.</h2>
        <p>Official BALLERS FC merchandise and kit information.</p>
      </div>

      <span class="shop-status">COMING SOON ↗</span>
    </section>

    <!-- CONTACT -->
    <section class="section contact-section" id="contact">
      <div class="section-kicker">06 / GET IN TOUCH</div>

      <div class="contact-grid">
        <div>
          <h2>STAY<br><em>CONNECTED.</em></h2>
          <p>
            For club enquiries, match information or media,
            contact the BALLERS FC team.
          </p>
        </div>

        <div class="contact-card">
          <span>OFFICIAL CLUB CHANNELS</span>
          <h3>CONTACT DETAILS<br>COMING SOON</h3>
          <p>
            Official email and social links will be added here
            once the club confirms them.
          </p>
        </div>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <a class="brand footer-brand" href="#home">
      <img src="assets/ballers-crest.jpg" alt="">
      <span>
        <strong>BALLERS FC</strong>
        <small>EST. 2026</small>
      </span>
    </a>

    <p>
      ONE CLUB. ONE GENERATION. ONE IDENTITY.<br>
      <b>UNITED BY FOOTBALL.</b>
    </p>

    <span class="copyright">
      © 2026 BALLERS FC · 2026/27 SEASON
    </span>
  </footer>

  <script src="script.js"></script>
</body>
</html>
